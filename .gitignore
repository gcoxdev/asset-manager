# Internal working notes, plans, scratch — not for the repo
internal/

# Node
node_modules/
dist/
dist-ssr/
web-dist/
*.local
.vite/

# Rust / Tauri
target/
**/src-tauri/target/
**/src-tauri/gen/

# Env & secrets
.env
.env.*
!.env.example

# Local app data / test vaults
*.db
*.db-shm
*.db-wal
vault/
# …except the test fixtures: vaults written by earlier builds, which
# protect nothing and must be committed (crates/am-storage/tests/compat.rs).
!crates/am-storage/tests/fixtures/*/vault/
!crates/am-storage/tests/fixtures/*/vault/catalog.db
test-vault/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Browser tests: recorded fixtures and run output
apps/desktop/tests-ui/.fixtures/
apps/desktop/test-results/
apps/desktop/playwright-report/
